//
//  GlowField.metal — Murmur ambient notch glow.
//
//  Domain-warped fBM colour field (техника Inigo Quilez,
//  https://iquilezles.org/articles/warp/). Вместо бегущего линейного
//  градиента — органично морфящиеся цветные пятна, перетекающие друг
//  в друга, в духе Apple Intelligence edge glow.
//
//  Вызывается через SwiftUI .colorEffect (macOS 14+). Без собственного
//  таймера — время приходит uniform'ом из TimelineView-интегратора.
//
#include <metal_stdlib>
using namespace metal;

// ---------- hash / value noise / fbm ----------

// Не-sin хэш: стабилен на больших координатах (time входит в p),
// fract(sin(...)*43758) деградирует уже на p ~ 10^3.
static inline float hash21(float2 p) {
    p = fract(p * float2(123.34, 345.45));
    p += dot(p, p + 34.345);
    return fract(p.x * p.y);
}

static inline float vnoise(float2 p) {
    float2 i = floor(p);
    float2 f = fract(p);
    float2 u = f * f * (3.0 - 2.0 * f);          // smoothstep-фейд
    float a = hash21(i);
    float b = hash21(i + float2(1.0, 0.0));
    float c = hash21(i + float2(0.0, 1.0));
    float d = hash21(i + float2(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// 3 октавы. Поворот между октавами убирает осевые артефакты сетки.
static inline float fbm(float2 p) {
    float v = 0.0;
    float amp = 0.5;
    const float2x2 rot = float2x2(0.8, 0.6, -0.6, 0.8);
    for (int i = 0; i < 3; i++) {
        v += amp * vnoise(p);
        p = rot * p * 2.03;
        amp *= 0.5;
    }
    return v;   // ~[0.1, 0.9]
}

// ---------- основной эффект ----------
//
// position — pt внутри вью; color — пиксель источника (белый Rectangle,
// нужен только alpha); size — размер вью в pt.
// time      — накопленные «циклы» из advancePhase (скорость уже
//             промодулирована голосом на CPU).
// warpAmp   — амплитуда domain warp, 1.1 (тишина) … 3.5 (крик).
// brightness— общий гейн яркости, 0.75 … 1.2.
// cA..cD    — 4 стопа палитры, уже слерпленные по transitionProgress.
//
[[ stitchable ]] half4 glowField(
    float2 position, half4 color, float2 size,
    float time, float warpAmp, float brightness,
    half4 cA, half4 cB, half4 cC, half4 cD
) {
    // Нормализация по высоте — базовый масштаб от высоты панели.
    float2 uv = position / max(size.y, 1.0);
    // Анизотропная частота: видимая зона — узкая лента вдоль контура челки,
    // поэтому вдоль X пятен должно быть заметно больше, чем по Y. С
    // изотропной 2.2 видимый срез поля был почти однотонным — «мало цветов».
    float2 p = uv * float2(4.6, 2.6);
    // Горизонтальная адвекция — знакомое «течение влево→вправо» из v3.21;
    // усилено, чтобы движение читалось даже на тонкой ленте.
    p.x -= time * 0.55;

    float t = time;
    // Уровень 1 warp'а: поле q, эволюционирует со временем. Коэффициенты
    // времени подняты ~×2 против первой итерации — морфинг виден на глаз,
    // а не только при сравнении скриншотов.
    float2 q = float2(
        fbm(p + 0.42 * t),
        fbm(p + float2(5.2, 1.3) - 0.31 * t)
    );
    // Уровень 2: поле r, искажённое q. Разные скорости/фазы по осям —
    // пятна вращаются и перетекают, а не пульсируют синхронно.
    float2 r = float2(
        fbm(p + warpAmp * q + float2(1.7, 9.2) + 0.55 * t),
        fbm(p + warpAmp * q + float2(8.3, 2.8) - 0.47 * t)
    );
    float v = fbm(p + warpAmp * r);

    // ---- АДДИТИВНЫЕ цветные пятна (neon), не каскад усреднений ----
    // Каскадный mix(mix, mix) усреднял стопы: розовый+циан давали серо-
    // фиолетовую «грязь». Свет складывается, а не усредняется: каждый
    // стоп получает СВОЮ мягкую маску из уже посчитанных независимых
    // каналов поля (v, q.x, q.y, r.x) и вклады суммируются. Пересечения
    // пятен дают яркие световые смеси (розовый+циан = электрический
    // светло-голубой), а не муть.
    // ---- ДВА СЛОЯ СВЕТА ----
    //
    // СЛОЙ 1 — непрерывная база: лента светится ВСЕГДА, без дырок.
    // Широкие перекрывающиеся маски тех же полей дают сплошной мягкий
    // градиент из пятнышек, который медленно переливается в тишине —
    // «сплошной светящийся объект по контуру челки».
    half b0 = half(smoothstep(0.18, 0.72, v));
    half b1 = half(smoothstep(0.20, 0.74, q.x));
    half b2 = half(smoothstep(0.20, 0.74, q.y));
    half b3 = half(smoothstep(0.20, 0.74, r.x));
    // База ЯРКАЯ по цвету (почти полная светимость стопов): лента
    // полупрозрачна, и над светлым фоном тусклый цвет ЗАТЕМНЯЛ его —
    // оранж поверх голубых обоев давал бурую «грязь». Яркость живёт в
    // цвете, мягкость — в альфе (см. низ): свечение светлее любого
    // фона по построению.
    half3 baseCol = (cA.rgb * b0 + cB.rgb * b1 + cC.rgb * b2 + cD.rgb * b3) * 0.95h;
    // Цветовое дно базы: даже в провалах всех масок лента остаётся
    // окрашенной — светлым миксом палитры, щелей и черноты нет.
    baseCol = max(baseCol, (cA.rgb + cB.rgb + cC.rgb + cD.rgb) * 0.22h);

    // СЛОЙ 2 — яркие капли поверх базы. Их размер ДЫШИТ от голоса:
    // warpAmp приходит уже промодулированный уровнем микрофона
    // (1.0 тишина … 4.4 крик). Тихо: редкие компактные вспышки;
    // громко: капли разрастаются и сливаются в потоки.
    float grow = saturate((warpAmp - 1.0) / 3.4);
    float lo = 0.58 - 0.18 * grow;
    float hi = lo + 0.24;
    half m0 = half(smoothstep(lo, hi, v));                 m0 *= m0;
    half m1 = half(smoothstep(lo + 0.02, hi + 0.02, q.x)); m1 *= m1;
    half m2 = half(smoothstep(lo + 0.02, hi + 0.02, q.y)); m2 *= m2;
    half m3 = half(smoothstep(lo + 0.02, hi + 0.02, r.x)); m3 *= m3;
    half3 dropCol = cA.rgb * m0
                  + cB.rgb * m1
                  + cC.rgb * m2
                  + cD.rgb * m3;

    // Свет складывается: база + капли.
    half3 col = baseCol + dropCol;

    // Пересечения пятен подсвечиваются, как настоящий свет: там, где
    // два луча перекрываются, становится ЯРЧЕ, а не грязнее. Без этого
    // члена частичные наложения (маски ~0.3-0.5) давали тусклые
    // серо-бурые полутона — ту самую «грязь».
    half cross = m0 * m1 + m0 * m2 + m0 * m3
               + m1 * m2 + m1 * m3 + m2 * m3;
    col += half3(0.90h, 0.95h, 1.00h) * cross * 0.55h;

    // Gamma-lift: поднимаем средние тона — полусмеси выходят из тёмной
    // зоны, тёмных пятен в переливах не остаётся.
    col = pow(max(col, half3(0.0h)), half3(0.85h));

    // Насыщенность вверх: отжимаем от серого, мягче чем раньше (1.35
    // пересушивал полусмеси в кислотно-грязные оттенки).
    half luma = dot(col, half3(0.299h, 0.587h, 0.114h));
    col = max(half3(0.0h), mix(half3(luma), col, 1.18h));

    // Светящиеся ядра: только на пиках главного поля, как редкие
    // bloom-вспышки.
    half peak = half(smoothstep(0.72, 0.97, v));
    col = mix(col, half3(1.2h), peak * 0.25h);

    col *= half(brightness);

    // Альфа: лёгкая непрерывная база (лента видна всегда, фон заметно
    // просвечивает — яркий цвет при низкой альфе подсвечивает фон, а не
    // перекрашивает его) + плотность капель сверху. До 0 не падает.
    half a = saturate(0.40h + 0.60h * saturate(m0 + m1 + m2 + m3 + peak));
    return half4(min(col, half3(2.0h)), 1.0h) * color.a * a;
}
